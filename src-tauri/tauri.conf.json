{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sonny",
  "version": "0.13.0",
  "identifier": "ai.nodemode.sonny",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "sonny",
        "url": "splash.html",
        "width": 360,
        "height": 180,
        "resizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Layered image editor",
    "longDescription": "sonny is a layered image editor in the NodeMode design system: layers, folders, masks, clipping, blend modes, selections, painting and a the reference app-compatible project format.",
    "copyright": "Copyright 2026 nodemode-ai. Portions copyright 2026 its authors.",
    "externalBin": ["binaries/sonny-engine"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "fileAssociations": [
      { "ext": ["sonny"], "name": "sonny Project", "description": "sonny layered image project", "role": "Editor", "mimeType": "application/x-sonny" },
      { "ext": ["comp"], "name": "the reference app Project", "description": "the reference app project", "role": "Editor" }
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/nodemode-ai/sonny/releases/latest/download/latest.json"]
    }
  }
}
