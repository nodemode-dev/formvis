{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "formvis",
 "version": "1.61.7",
  "identifier": "ai.nodemode.formvis",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "formvis",
        "url": "splash.html",
        "width": 360,
        "height": 180,
        "resizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Layered image editor",
 "longDescription": "formvis is a layered image editor in the NodeMode design system: layers, folders, masks, clipping, blend modes, selections, painting, and its own .fmv project files.",
 "copyright": "Copyright 2026 nodemode-ai.",
    "externalBin": ["binaries/formvis-engine"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "fileAssociations": [
      { "ext": ["fmv", "formvis"], "name": "formvis Project", "description": "formvis layered image project", "role": "Editor", "mimeType": "application/x-formvis" }
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/nodemode-ai/formvis/releases/latest/download/latest.json"]
    }
  }
}
