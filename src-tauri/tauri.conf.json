{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "formvis",
 "version": "1.90.8",
  "identifier": "ai.nodemode.formvis",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "formvis",
        "url": "splash.html",
        "width": 360,
        "height": 180,
        "resizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Layered image editor",
 "longDescription": "formvis is a layered image editor in the NodeMode design system: layers, folders, masks, clipping, blend modes, selections, painting, and its own .fvd project files.",
 "copyright": "Copyright 2026 nodemode-ai.",
    "externalBin": ["binaries/formvis-engine"],
    "resources": { "../licenses": "licenses" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "fileAssociations": [
      { "ext": ["fvd", "fmv", "formvis"], "name": "formvis Project", "description": "formvis layered image project", "role": "Editor", "mimeType": "application/x-formvis" },
      { "ext": ["psd", "psb", "png", "jpg", "jpeg", "tif", "tiff", "webp", "exr", "ora"], "name": "Picture", "description": "Picture formvis can open", "role": "Editor" }
    ],
    "linux": {
      "deb": {
        "recommends": ["xdg-desktop-portal-gtk | xdg-desktop-portal", "fonts-dejavu-core"],
        "files": { "/usr/share/formvis/libcheck": "../setup/libcheck" }
      }
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "wix": { "fragmentPaths": ["wix/app-paths.wxs"], "componentRefs": ["AppPathsRegistration"] }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/nodemode-ai/formvis/releases/latest/download/latest.json"]
    }
  }
}
