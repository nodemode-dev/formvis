#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
[ -f "$FORMVIS_ROOT/frontend/dist/index.html" ] || "$FORMVIS_ROOT/setup/build_frontend"
cv_venv
cd "$FORMVIS_ROOT/backend"
export FORMVIS_DIST="$FORMVIS_ROOT/frontend/dist"
cv_say "serving http://127.0.0.1:${FORMVIS_PORT:-8190}"
exec uvicorn app.main:app --host "${FORMVIS_HOST:-127.0.0.1}" --port "${FORMVIS_PORT:-8190}"
