#!/usr/bin/env bash
# Linux startup library check and file dialog diagnostics.
#   bash setup/libcheck [--quiet] [--dialogs] [BINARY ...]
# Names every shared library the desktop program and its engine cannot find, and says what the file dialogs need.
# Exit 0: nothing missing. Exit 1: a library is missing. Not Linux: prints one line and exits 0.
set -u
quiet=0 dialogs=0 bins=()
for arg in "$@"; do
  case "$arg" in
    --quiet) quiet=1 ;;
    --dialogs) dialogs=1 ;;
    -h|--help) sed -n '2,6p' "$0"; exit 0 ;;
    *) bins+=("$arg") ;;
  esac
done
say() { [ "$quiet" = 1 ] || printf '%s\n' "$*"; }

if [ "$(uname -s 2>/dev/null)" != Linux ]; then
  say "libcheck: this check is for Linux only."
  exit 0
fi

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/.." 2>/dev/null && pwd)"
if [ ${#bins[@]} -eq 0 ]; then
  for c in /usr/bin/formvis /usr/lib/formvis/formvis-engine /usr/bin/formvis-engine \
           "$root"/src-tauri/target/release/formvis "${XDG_CACHE_HOME:-$HOME/.cache}"/formvis/tauri-target/release/formvis \
           "$root"/src-tauri/binaries/formvis-engine-*; do
    [ -f "$c" ] && bins+=("$c")
  done
fi

missing=0
find_lib() { ldconfig -p 2>/dev/null | grep -q -- "$1"; }

if [ ${#bins[@]} -gt 0 ] && command -v ldd >/dev/null 2>&1; then
  for b in "${bins[@]}"; do
    out="$(ldd "$b" 2>&1 || true)"
    lost="$(printf '%s\n' "$out" | awk '/not found/ {print $1}' | sort -u)"
    if [ -n "$lost" ]; then
      missing=1
      printf 'libcheck: %s cannot find:\n' "$b"
      printf '  %s\n' $lost
    else
      say "libcheck: $b finds every library it links."
    fi
  done
else
  # No built program to inspect: check the libraries the window needs by name.
  for lib in libwebkit2gtk-4.1.so.0 libjavascriptcoregtk-4.1.so.0 libgtk-3.so.0 libsoup-3.0.so.0 libssl.so.3 libxdo.so.3; do
    if ! find_lib "$lib"; then
      missing=1
      printf 'libcheck: missing %s\n' "$lib"
    fi
  done
  if ! find_lib libayatana-appindicator3.so.1 && ! find_lib libappindicator3.so.1; then
    missing=1
    printf 'libcheck: missing libayatana-appindicator3.so.1 (or libappindicator3.so.1)\n'
  fi
  [ "$missing" = 0 ] && say "libcheck: the window's libraries are present."
fi

if [ "$missing" = 1 ]; then
  cat <<'EOF'
libcheck: on Debian or Ubuntu these usually come from:
  sudo apt install libwebkit2gtk-4.1-0 libgtk-3-0 libayatana-appindicator3-1 libsoup-3.0-0 libssl3 libxdo3
EOF
fi

if [ "$dialogs" = 1 ] || [ "$missing" = 1 ]; then
  echo "file dialogs:"
  echo "  session: ${XDG_SESSION_TYPE:-unknown}, DISPLAY=${DISPLAY:-unset}, WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-unset}"
  [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] || echo "  no display is set: no window or dialog can open from this shell"
  find_lib libgtk-3.so.0 && echo "  GTK 3: present (the open and save dialogs use it)" || echo "  GTK 3: MISSING (install libgtk-3-0)"
  if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] || [ -S "/run/user/$(id -u)/bus" ]; then
    echo "  session bus: present"
    if command -v busctl >/dev/null 2>&1 && busctl --user list 2>/dev/null | grep -q org.freedesktop.portal.Desktop; then
      echo "  desktop portal: running"
    else
      echo "  desktop portal: not running (only matters for sandboxed installs such as Flatpak; install xdg-desktop-portal and a backend such as xdg-desktop-portal-gtk)"
    fi
  else
    echo "  session bus: none found (dialogs inside a sandbox need it)"
  fi
  for t in zenity kdialog; do command -v "$t" >/dev/null 2>&1 && echo "  $t: present"; done
  [ -n "${GTK_USE_PORTAL:-}" ] && echo "  GTK_USE_PORTAL=$GTK_USE_PORTAL"
fi

exit "$missing"
