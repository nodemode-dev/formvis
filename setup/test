#!/usr/bin/env bash
source "$(dirname "$0")/lib.sh"
which="${1:-all}"
case "$which" in all|unit|backend|e2e) ;; *) cv_say "unknown test suite: $which (use unit, backend, e2e or nothing for all)"; exit 2 ;; esac
fail=0
py="$SONNY_ROOT/backend/venv/bin/python"
[ -x "$py" ] || py="$(cv_python)" || { cv_say "Python 3.12+ is required"; exit 1; }
run() { cv_say "$1"; shift; "$@" || fail=1; }
if [ "$which" = all ] || [ "$which" = unit ]; then
  run "unit tests (vitest)" bash -c "cd '$SONNY_ROOT/frontend' && npm test --silent"
fi
if [ "$which" = all ] || [ "$which" = backend ]; then
  "$py" -c "import pytest, httpx" >/dev/null 2>&1 || "$py" -m pip install -q pytest httpx
  run "backend tests (pytest)" bash -c "cd '$SONNY_ROOT/backend' && '$py' -m pytest -q tests"
fi
if [ "$which" = all ] || [ "$which" = e2e ]; then
  if "$py" -c "import pytest, playwright" >/dev/null 2>&1; then
    run "browser tests (Playwright, dev build on 5190)" bash -c "cd '$SONNY_ROOT' && '$py' -m pytest -q e2e"
  else
    cv_say "browser tests skipped: run '$py -m pip install pytest playwright && $py -m playwright install chromium' to enable them"
    [ "$which" = e2e ] && fail=1
  fi
fi
exit "$fail"
