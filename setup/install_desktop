#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
cv_venv
cd "$FORMVIS_ROOT/backend"
if [ "$(cv_os)" = macos ]; then pip install -r requirements_desktop_macos.txt; else pip install -r requirements_desktop.txt; fi
"$FORMVIS_ROOT/setup/opencv_macos"
if ! command -v cargo >/dev/null 2>&1; then
  cv_say "Rust is not installed. Install it from https://rustup.rs then rerun ./formvis install-desktop"
  exit 1
fi
if [ "$(cv_os)" = linux ] && ! pkg-config --exists webkit2gtk-4.1 2>/dev/null; then
  cv_say "Tauri needs system libraries. On Debian or Ubuntu run:"
  cv_say "sudo apt install libwebkit2gtk-4.1-dev build-essential curl wget file libxdo-dev libssl-dev libayatana-appindicator3-dev librsvg2-dev patchelf"
  exit 1
fi
[ -x "$FORMVIS_ROOT/frontend/node_modules/.bin/tauri" ] || ( cd "$FORMVIS_ROOT/frontend" && npm install )
cv_say "desktop toolchain ready: rustc $(rustc --version | awk '{print $2}')"
