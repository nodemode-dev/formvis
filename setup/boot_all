#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
cd "$SONNY_ROOT"
pids=()
( cd backend && ./boot_backend ) &
pids+=($!)
( cd frontend && ./boot_frontend ) &
pids+=($!)
trap 'kill "${pids[@]}" 2>/dev/null' EXIT INT TERM
cv_say "frontend http://localhost:5190 · backend http://127.0.0.1:${SONNY_PORT:-8190}"
wait
