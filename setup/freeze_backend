#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
cv_venv
python -c "import PyInstaller" 2>/dev/null || cv_die "PyInstaller missing, run ./formvis install-desktop"
triple="$(cv_target_triple)" || cv_die "rustc not found; install Rust or set FORMVIS_TARGET"
[ -f "$FORMVIS_ROOT/frontend/dist/index.html" ] || "$FORMVIS_ROOT/setup/build_frontend"
cd "$FORMVIS_ROOT/backend"
sep=":"
[ "$(cv_os)" = windows ] && sep=";"
ext="$(cv_exe)"
extra=()
if [ "${FORMVIS_FREEZE_ML:-0}" = 1 ]; then extra+=(--collect-all rembg --collect-all onnxruntime --hidden-import rembg); fi
rm -rf build/pyinstaller dist-engine
pyinstaller --noconfirm --clean --onefile --name formvis-engine \
  --distpath dist-engine --workpath build/pyinstaller --specpath build/pyinstaller \
  --add-data "$FORMVIS_ROOT/frontend/dist${sep}frontend_dist" \
  --collect-submodules app --collect-submodules uvicorn --collect-submodules keyring --hidden-import cv2 \
  --exclude-module pillow_heif "${extra[@]}" \
  "$FORMVIS_ROOT/backend/formvis_engine.py"
mkdir -p "$FORMVIS_ROOT/src-tauri/binaries"
out="$FORMVIS_ROOT/src-tauri/binaries/formvis-engine-${triple}${ext}"
cp "dist-engine/formvis-engine${ext}" "$out"
"$out" --selfcheck
cv_say "sidecar ready: $out"
