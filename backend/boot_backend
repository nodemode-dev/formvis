#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"
[ -f venv/bin/activate ] || { echo "[formvis] backend venv missing, run ./formvis install" >&2; exit 1; }
# shellcheck disable=SC1091
source venv/bin/activate
exec uvicorn app.main:app --reload --host "${FORMVIS_HOST:-127.0.0.1}" --port "${FORMVIS_PORT:-8190}"
