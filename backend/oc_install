#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"
# Every venv comes from setup/lib.sh's cv_python: 3.12 or newer, and 3.12 to 3.13 on Intel Macs.
source ../setup/lib.sh
PY="$(cv_python)" || cv_die "Python 3.12 or newer is required (3.12 or 3.13 on Intel Macs)"
old=venv/bin/python
[ -x "$old" ] || old=venv/Scripts/python
if [ -d venv ] && [ -x "$old" ] && ! cv_python_ok "$old"; then
  cv_say "backend/venv uses $("$old" -V 2>&1), which this machine cannot install into; recreating it with $("$PY" -V 2>&1)"
  rm -rf venv
fi
[ -d venv ] || "$PY" -m venv venv
act=venv/bin/activate
[ -f "$act" ] || act=venv/Scripts/activate
# shellcheck disable=SC1090
source "$act"
python -m pip install --upgrade pip
if [[ "$OSTYPE" == "darwin"* ]]; then
  pip install -r requirements_macos.txt
else
  pip install -r requirements.txt
fi
