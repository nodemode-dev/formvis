#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"
usage() {
  # The version in the first line (1.61.9): a copy that missed an update shows it at once, not as "unknown command".
  printf 'formvis %s · layered image editor\n' "$(sed -n "s/^export const VERSION = '\(.*\)';$/\1/p" frontend/src/version.ts 2>/dev/null)"
  cat << 'EOF'

usage: ./formvis [command] [options]

  (none) | boot       boot backend (8190) and frontend (5190) together
  install [--lite]    install backend, the ML extra (skipped with --lite) and frontend
  install-ml          install rembg + onnxruntime and fetch the background model
  install-desktop     install PyInstaller and check the Rust and Tauri toolchain
  backend             boot the backend only
  frontend            boot the frontend only
  build               production build of the frontend into frontend/dist
  serve               serve the built frontend from the backend on 127.0.0.1:8190
  freeze              freeze the backend into the Tauri sidecar binary
  desktop dev|build   run or bundle the desktop app
  doctor              check the toolchain, installs and ports
  test [unit|backend|e2e]  run the tests (all three suites by default)
  counts [--check]    the README's code sizes and blend-mode count (--check: exit 1 if README.md has drifted)
  counts --commands [--check]  the command catalogue's size and any command without metadata (--check: exit 1 under 620 or while any lacks it)
  bench [--frames N]  time formvis's drawing paths on this computer's real graphics; writes bench-results/ to send back
  verify-local [--small]  run Krea 2 and FLUX.2 [klein] once here (licences and downloads asked first); writes bench-results/
  mcp                 formvis over MCP's stdio transport, for Claude Desktop and other MCP clients
  cli list|describe|run|process|droplet  the command catalogue of the open window: list [text], describe <id>, run <id> key=value ...; process <files> --action NAME (file in, file out); droplet <action> (a script to drop files onto)
  agents install|sync  set up Claude Code, Codex and Cursor for editing in plain language (install), or refresh every skill and its generated references (sync [--check])
  clean [--all]       remove build output (--all also venv and node_modules)
  help                this text
EOF
}
cmd="${1:-boot}"
[ $# -gt 0 ] && shift
case "$cmd" in
  boot|dev) exec setup/boot_all "$@" ;;
  install) exec setup/install_all "$@" ;;
  install-ml) exec setup/install_ml "$@" ;;
  install-desktop) exec setup/install_desktop "$@" ;;
  backend) exec setup/boot_backend "$@" ;;
  frontend) exec setup/boot_frontend "$@" ;;
  build) exec setup/build_frontend "$@" ;;
  serve) exec setup/serve "$@" ;;
  freeze) exec setup/freeze_backend "$@" ;;
  desktop)
    sub="${1:-dev}"
    [ $# -gt 0 ] && shift
    case "$sub" in
      dev) exec setup/desktop_dev "$@" ;;
      build) exec setup/desktop_build "$@" ;;
      *) usage; exit 2 ;;
    esac ;;
  doctor) exec setup/doctor "$@" ;;
  test) exec setup/test "$@" ;;
  counts) exec setup/counts "$@" ;;
  bench) exec setup/bench "$@" ;;
  verify-local) exec setup/verify_local "$@" ;;
  mcp) exec python3 setup/mcp_stdio.py "$@" ;;
  agents) exec python3 setup/agents.py "$@" ;;
  cli) exec python3 setup/cli.py "$@" ;;
  clean) exec setup/clean "$@" ;;
  help|-h|--help) usage ;;
  *) printf '[formvis] unknown command: %s\n\n' "$cmd"; usage; exit 2 ;;
esac
